<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.App.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconSize">@dimen/bottom_nav_icon_size</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.App.BottomNavigationView</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.App.BottomNavigationView</item>
        <item name="android:textColorHint">#757575</item> <!-- Set globally if needed -->
        <item name="colorPrimary">@color/red</item>
        <item name="colorPrimaryDark">@color/red</item>
        <item name="colorAccent">@color/red</item>
        <item name="itemPaddingTop">8dp</item>
        <item name="itemPaddingBottom">8dp</item>
    </style>
    
    <style name="TextAppearance.App.BottomNavigationView" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/bottom_nav_text_size</item>
        <item name="android:textStyle">bold</item>
    </style>
    
    <style name="CustomHintStyle" parent="TextAppearance.AppCompat.Small">
        <item name="android:textSize">14sp</item>
        <item name="android:textColorHint">#000000</item>
        <item name="android:textColor">#000000</item>
        <item name="android:background">@null</item>
    </style>
    <style name="MealCardStyle">
        <item name="android:padding">12dp</item>
        <item name="android:background">#D1A86B</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:elevation">4dp</item>
    </style>

</resources>