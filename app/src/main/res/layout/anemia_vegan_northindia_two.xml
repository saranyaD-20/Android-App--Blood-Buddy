<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#f4f7f6">

    <!-- Header Section -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="15dp"
        android:paddingTop="30dp">
        <TextView
            android:id="@+id/header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Personalized Food Suggestions for Anemia"
            android:textSize="19sp"
            android:textColor="#4CAF50"
            android:textStyle="bold"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:id="@+id/header_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(Vegan | North Indian)"
            android:textSize="18sp"
            android:textColor="#555"
            android:layout_below="@id/header_title"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>

    <!-- Meal Type - Breakfast -->
    <TextView
        android:id="@+id/meal_breakfast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🍽️ Breakfast"
        android:textSize="24sp"
        android:textColor="#333"
        android:paddingBottom="10dp"
        android:paddingTop="30dp"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:background="#ddd"/>

    <!-- Meal Card for Moong Dal Cheela -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#f9f9f9"
        android:padding="20dp"
        android:layout_marginBottom="20dp"
        android:elevation="4dp"
        android:layout_gravity="center">
        <ImageView
            android:id="@+id/meal_image"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginEnd="20dp"
            android:src="@drawable/moong_dal_cheela"
            android:scaleType="centerCrop"
            android:contentDescription="Moong Dal Cheela"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Moong Dal Cheela"
                android:textSize="22sp"
                android:textColor="#333"
                android:layout_marginBottom="10dp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❤️ High in Protein and Iron"
                android:textSize="16sp"
                android:textColor="#555"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📏 Portion: 2 Cheelas"
                android:textSize="14sp"
                android:textColor="#27ae60"
                android:layout_marginTop="8dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ May contain: cumin seeds"
                android:textSize="14sp"
                android:textColor="#e74c3c"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 Alternative: Use coriander leaves for added flavor"
                android:textSize="14sp"
                android:textColor="#f39c12"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Meal Type - Lunch -->
    <TextView
        android:id="@+id/meal_lunch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🍽️ Lunch"
        android:textSize="24sp"
        android:textColor="#333"
        android:paddingBottom="10dp"
        android:paddingTop="30dp"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:background="#ddd"/>

    <!-- Meal Card for Chole Bhature -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#f9f9f9"
        android:padding="20dp"
        android:layout_marginBottom="20dp"
        android:elevation="4dp"
        android:layout_gravity="center">
        <ImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/chole_bhature"
            android:layout_marginEnd="20dp"
            android:scaleType="centerCrop"
            android:contentDescription="Chole Bhature"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chole Bhature"
                android:textSize="22sp"
                android:textColor="#333"
                android:layout_marginBottom="10dp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❤️ Rich in Protein, Iron, and Fiber"
                android:textSize="16sp"
                android:textColor="#555"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📏 Portion: 1 plate"
                android:textSize="14sp"
                android:textColor="#27ae60"
                android:layout_marginTop="8dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ May contain: gluten, ghee"
                android:textSize="14sp"
                android:textColor="#e74c3c"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 Alternative: Make bhature with gluten-free flour"
                android:textSize="14sp"
                android:textColor="#f39c12"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Tips Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#e9f7f3"
        android:padding="20dp"
        android:orientation="vertical"
        android:layout_marginTop="30dp"
        android:gravity="center">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧠 Health Tip:"
            android:textSize="22sp"
            android:textColor="#333"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add a pinch of black pepper to your meals to enhance iron absorption."
            android:textSize="16sp"
            android:textColor="#555"/>
    </LinearLayout>

</LinearLayout>
